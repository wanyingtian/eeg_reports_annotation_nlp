{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/eeg-review/mistral-task-adaptation-plan.schema.json",
  "title": "JBHI post-submission Mistral task-adaptation plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "plan_id",
    "proposed_evidence_layer_id",
    "base_evidence_layer",
    "scientific_question",
    "hypothesis",
    "component_sequence",
    "task_adapter",
    "signals",
    "freeze",
    "evaluation",
    "certainty_mapping",
    "claim_boundary",
    "privacy_boundary"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "status": {
      "enum": ["preregistered_unfrozen", "frozen_before_evaluation", "retired"]
    },
    "plan_id": {"type": "string", "minLength": 1},
    "proposed_evidence_layer_id": {"const": "post_submission_mistral_adapted"},
    "base_evidence_layer": {"const": "reproduced_mistral"},
    "scientific_question": {"type": "string", "minLength": 1},
    "hypothesis": {"type": "string", "minLength": 1},
    "component_sequence": {
      "const": [
        "reproduced_mistral_historical_four_level",
        "binary_core_historical_margin",
        "binary_core_fitted_per_category_margin"
      ]
    },
    "task_adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter_id",
        "route",
        "methods",
        "parameter_update",
        "teacher_model_outputs_used",
        "artifact"
      ],
      "properties": {
        "adapter_id": {"type": "string", "minLength": 1},
        "route": {"const": "binary_core_schema_guided_and_post_hoc_certainty_mapping"},
        "methods": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "iterative_prompt_engineering",
              "grammar_constrained_decoding",
              "evidence_extraction",
              "deterministic_consistency_checks",
              "post_hoc_certainty_mapping",
              "soft_prompt_tuning",
              "lora",
              "teacher_student_distillation"
            ]
          }
        },
        "parameter_update": {"const": "certainty_threshold_margins_only"},
        "teacher_model_outputs_used": {"const": false},
        "artifact": {"$ref": "#/$defs/artifact"}
      }
    },
    "signals": {
      "type": "array",
      "minItems": 7,
      "items": {"$ref": "#/$defs/signal"}
    },
    "freeze": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "author_group_admitted",
        "frozen_before_evaluation",
        "selection_rule",
        "stopping_rule",
        "receipt"
      ],
      "properties": {
        "author_group_admitted": {"type": "boolean"},
        "frozen_before_evaluation": {"type": "boolean"},
        "selection_rule": {"type": "string", "minLength": 1},
        "stopping_rule": {"type": "string", "minLength": 1},
        "receipt": {"$ref": "#/$defs/artifact"}
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "development_cohort_id",
        "evaluation_cohort_ids",
        "exact_same_case_required",
        "patient_grouping_required_when_confirmed",
        "primary_contrast",
        "attribution_scope",
        "medgemma_comparison_scope"
      ],
      "properties": {
        "development_cohort_id": {"const": "zoe_development_first_100_ra"},
        "evaluation_cohort_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["zoe_evaluation_1395", "maria_evaluation_499"]},
          "minItems": 2,
          "maxItems": 2
        },
        "exact_same_case_required": {"const": true},
        "patient_grouping_required_when_confirmed": {"const": true},
        "primary_contrast": {"type": "string", "minLength": 1},
        "attribution_scope": {"type": "string", "minLength": 1},
        "medgemma_comparison_scope": {"type": "string", "minLength": 1}
      }
    },
    "certainty_mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_feature",
        "output_interpretation",
        "core_boundary",
        "threshold_shape",
        "candidate_margins",
        "historical_margin",
        "selection_objective",
        "tie_break_rule",
        "minimum_valid_pairs",
        "minimum_pairs_per_core_side",
        "insufficient_support_action",
        "missing_probability_action",
        "crossfit_diagnostic",
        "resampling_method",
        "resampling_iterations",
        "resampling_seed",
        "interval_level",
        "development_manifest",
        "interpretation_boundary"
      ],
      "properties": {
        "input_feature": {
          "const": "grammar_normalized_binary_core_positive_probability"
        },
        "output_interpretation": {"const": "four_level_certainty_annotation"},
        "core_boundary": {"const": 0.5},
        "threshold_shape": {
          "const": "per_category_symmetric_margin_around_fixed_core_boundary"
        },
        "candidate_margins": {
          "const": [0.1, 0.2, 0.3]
        },
        "historical_margin": {"const": 0.1},
        "selection_objective": {"const": "maximize_exact_four_level_agreement"},
        "tie_break_rule": {
          "const": "closest_to_historical_margin_then_smaller_margin"
        },
        "minimum_valid_pairs": {"type": "integer", "minimum": 1},
        "minimum_pairs_per_core_side": {"type": "integer", "minimum": 1},
        "insufficient_support_action": {
          "const": "retain_historical_margin_and_mark_not_fitted"
        },
        "missing_probability_action": {"const": "exclude_pair_and_report_availability"},
        "crossfit_diagnostic": {"const": "leave_one_report_out_selection"},
        "resampling_method": {
          "const": "stratified_by_reference_core_side_report_bootstrap"
        },
        "resampling_iterations": {"type": "integer", "minimum": 100},
        "resampling_seed": {"type": "integer"},
        "interval_level": {"const": 0.95},
        "development_manifest": {"$ref": "#/$defs/artifact"},
        "interpretation_boundary": {"type": "string", "minLength": 1}
      }
    },
    "claim_boundary": {"type": "string", "minLength": 1},
    "privacy_boundary": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": ["string", "null"]},
        "sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-fA-F]{64}$"
        }
      }
    },
    "signal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signal_id",
        "signal_type",
        "use",
        "used_for_parameter_or_variant_selection",
        "outcomes_inspected",
        "artifact",
        "note"
      ],
      "properties": {
        "signal_id": {"type": "string", "minLength": 1},
        "signal_type": {"type": "string", "minLength": 1},
        "use": {
          "enum": [
            "development",
            "design_prior",
            "evaluation_only",
            "context_only_prohibited_for_selection"
          ]
        },
        "used_for_parameter_or_variant_selection": {"type": "boolean"},
        "outcomes_inspected": {"type": "boolean"},
        "artifact": {"$ref": "#/$defs/artifact"},
        "note": {"type": "string", "minLength": 1}
      }
    }
  }
}
