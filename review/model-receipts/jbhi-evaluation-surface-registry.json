{
  "schema_version": 1,
  "status": "public_safe_design_registry_no_result_values",
  "study_id": "jbhi-02463",
  "task_semantics_id": "five-four-level-eeg-findings-v1",
  "factor_definitions": [
    {
      "factor_id": "model_family",
      "scope": "configuration",
      "allowed_values": [
        "mistral-7b-instruct-v0.2",
        "medgemma-27b-text-it"
      ],
      "interpretation": "The upstream model family; it does not by itself identify a complete producing system."
    },
    {
      "factor_id": "quantization",
      "scope": "configuration",
      "allowed_values": [
        "Q5_K_M",
        "Q2_K",
        "Q4_K_S"
      ],
      "interpretation": "The weight quantization used for a run; changing it can change outputs and resource use."
    },
    {
      "factor_id": "interface_mode",
      "scope": "configuration",
      "allowed_values": [
        "historical_raw_completion",
        "model_native_chat",
        "external_v5g_pending"
      ],
      "interpretation": "The model-facing input envelope. This is distinct from the task prompt and output grammar."
    },
    {
      "factor_id": "task_semantics",
      "scope": "configuration",
      "allowed_values": [
        "five-four-level-eeg-findings-v1"
      ],
      "interpretation": "The five EEG findings, four-level scale, and binary 1-2 versus 3-4 decision boundary inherited from the submitted study."
    },
    {
      "factor_id": "prompt_variant",
      "scope": "configuration",
      "allowed_values": [
        "historical-classification-v1",
        "external-v1",
        "external-v2",
        "external-v3",
        "external-v4",
        "external-v5",
        "external-v6",
        "external-v7",
        "external-v8",
        "external-v9",
        "external-v10",
        "external-v5g"
      ],
      "interpretation": "A byte-identifiable task prompt. External labels remain summary-level names until exact source intake."
    },
    {
      "factor_id": "grammar_mode",
      "scope": "configuration",
      "allowed_values": [
        "historical-four-level-json",
        "external-consistency-grammar",
        "external-pending"
      ],
      "interpretation": "The structured-output contract. A consistency grammar is a separate factor from prompt content and model interface."
    },
    {
      "factor_id": "cohort",
      "scope": "population",
      "allowed_values": [
        "zoe-development-100",
        "zoe-evaluation-1395",
        "maria-evaluation-499",
        "evaluation-combined-1894",
        "external-labeled-pooled-1994",
        "external-labeled-2493-unreconciled",
        "external-large-unlabeled-45545"
      ],
      "interpretation": "The exact report population. Pooled surfaces that include development cases are not interchangeable with held-out evaluation."
    },
    {
      "factor_id": "reference",
      "scope": "reference",
      "allowed_values": [
        "ld-reference-annotator",
        "sg-second-annotator",
        "none"
      ],
      "interpretation": "The comparison reference. Agreement with an annotator is not clinical ground truth or a human ceiling."
    },
    {
      "factor_id": "selection_role",
      "scope": "population",
      "allowed_values": [
        "source-of-record",
        "frozen-result-blind",
        "development-only",
        "held-out-once",
        "exploratory-pooled-selection",
        "not-applicable",
        "external-pending"
      ],
      "interpretation": "How the surface was used for configuration choice. Selection and evaluation roles cannot be inferred from row count alone."
    },
    {
      "factor_id": "evidence_layer",
      "scope": "provenance",
      "allowed_values": [
        "submitted_mistral",
        "reproduced_mistral",
        "post_submission_mistral_interface_sensitivity",
        "post_submission_medgemma",
        "external_v5g_pending_intake"
      ],
      "interpretation": "The scientific provenance layer. Integration records lineage and does not transfer contribution ownership."
    }
  ],
  "metric_definitions": [
    {
      "metric_id": "core_binary_f1",
      "level": "label",
      "statistic": "positive-class F1 after mapping levels 1-2 to absent and 3-4 to present",
      "reference_requirement": "required",
      "unlabeled_allowed": false,
      "definition_status": "defined",
      "interpretation": "Balances precision and recall for the present class; it omits true negatives and should be read with raw counts."
    },
    {
      "metric_id": "binary_accuracy",
      "level": "label",
      "statistic": "fraction of present-absent decisions equal to the reference",
      "reference_requirement": "required",
      "unlabeled_allowed": false,
      "definition_status": "defined",
      "interpretation": "Overall agreement on the binary decision; class imbalance can make it look high."
    },
    {
      "metric_id": "exact_four_level_accuracy",
      "level": "label",
      "statistic": "fraction of exact 1-4 levels equal to the reference",
      "reference_requirement": "required",
      "unlabeled_allowed": false,
      "definition_status": "defined",
      "interpretation": "Agreement on both direction and stated confidence level."
    },
    {
      "metric_id": "exact_four_level_f1_external_formula_pending",
      "level": "label",
      "statistic": "external exact-level F1; class averaging and positive-class construction pending source intake",
      "reference_requirement": "required",
      "unlabeled_allowed": false,
      "definition_status": "pending_producing_bundle",
      "interpretation": "Registers the endpoint shown in external summaries without silently equating it to exact-level accuracy."
    },
    {
      "metric_id": "whole_report_binary_exact_match_accuracy",
      "level": "report",
      "statistic": "fraction of reports with all five binary decisions equal to the reference",
      "reference_requirement": "required",
      "unlabeled_allowed": false,
      "definition_status": "defined",
      "interpretation": "A strict five-label exact-match percentage, not an F1 score."
    },
    {
      "metric_id": "whole_report_four_level_exact_match_accuracy",
      "level": "report",
      "statistic": "fraction of reports with all five exact 1-4 levels equal to the reference",
      "reference_requirement": "required",
      "unlabeled_allowed": false,
      "definition_status": "defined",
      "interpretation": "The strictest report-level agreement endpoint."
    },
    {
      "metric_id": "paired_binary_accuracy_difference",
      "level": "label",
      "statistic": "same-case difference in binary accuracy with paired uncertainty",
      "reference_requirement": "required",
      "unlabeled_allowed": false,
      "definition_status": "defined",
      "interpretation": "Measures the paired change on exactly matched reports; it does not attribute the change to one configuration component."
    },
    {
      "metric_id": "positive_call_rate",
      "level": "label",
      "statistic": "fraction of reports assigned levels 3-4",
      "reference_requirement": "prohibited",
      "unlabeled_allowed": true,
      "definition_status": "defined",
      "interpretation": "Describes model output prevalence on unlabeled data and cannot determine correctness."
    },
    {
      "metric_id": "model_pair_binary_agreement",
      "level": "label_or_report",
      "statistic": "fraction of reports on which two model outputs make the same binary call",
      "reference_requirement": "optional",
      "unlabeled_allowed": true,
      "definition_status": "defined",
      "interpretation": "Locates model disagreement but cannot identify which output is clinically correct."
    }
  ],
