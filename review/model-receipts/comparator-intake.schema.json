{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/eeg-review/comparator-intake.schema.json",
  "title": "JBHI comparator producing-bundle intake",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "evidence_layer",
    "provenance",
    "model_identity",
    "runtime",
    "prompt",
    "grammar",
    "key_contract",
    "cohorts",
    "privacy_boundary"
  ],
  "properties": {
    "schema_version": {"const": 3},
    "status": {
      "enum": ["template_unreceipted", "draft", "frozen", "source_of_record", null]
    },
    "evidence_layer": {
      "enum": [
        "submitted_mistral",
        "reproduced_mistral",
        "post_submission_medgemma",
        null
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "graph_id",
        "root_node_id",
        "admission",
        "nodes",
        "role_assertions",
        "distribution_status",
        "integration_transfers_ownership",
        "scientific_governance_note"
      ],
      "properties": {
        "graph_id": {"type": ["string", "null"]},
        "root_node_id": {"type": ["string", "null"]},
        "admission": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "producing_bundle_received",
            "validated",
            "author_group_admitted",
            "integrated",
            "transition_receipt"
          ],
          "properties": {
            "status": {
              "enum": [
                "external_pending_intake",
                "external_receipted",
                "validated_pending_author_admission",
                "author_group_admitted",
                "integrated",
                null
              ]
            },
            "producing_bundle_received": {"type": ["boolean", "null"]},
            "validated": {"type": ["boolean", "null"]},
            "author_group_admitted": {"type": ["boolean", "null"]},
            "integrated": {"type": ["boolean", "null"]},
            "transition_receipt": {"$ref": "#/$defs/artifact"}
          }
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/provenance_node"}
        },
        "role_assertions": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/role_assertion"}
        },
        "distribution_status": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ancestry_receipt", "source_configuration", "outputs", "weights"],
          "properties": {
            "ancestry_receipt": {"enum": ["receipt_only", null]},
            "source_configuration": {
              "enum": ["receipt_only", "source_config_publishable", null]
            },
            "outputs": {"enum": ["outputs_governed", null]},
            "weights": {"enum": ["weights_not_redistributed", null]}
          }
        },
        "integration_transfers_ownership": {"type": ["boolean", "null"]},
        "scientific_governance_note": {"type": ["string", "null"]}
      }
    },
    "model_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "upstream_repo_id",
        "upstream_revision",
        "artifact",
        "size_bytes",
        "quantization",
        "license",
        "license_terms_url",
        "license_notice"
      ],
      "properties": {
        "upstream_repo_id": {"type": ["string", "null"]},
        "upstream_revision": {"type": ["string", "null"]},
        "artifact": {"$ref": "#/$defs/artifact"},
        "size_bytes": {"type": ["integer", "null"], "minimum": 0},
        "quantization": {"type": ["string", "null"]},
        "license": {"type": ["string", "null"]},
        "license_terms_url": {"type": ["string", "null"]},
        "license_notice": {"type": ["string", "null"]}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine",
        "engine_version",
        "engine_revision",
        "chat_template",
        "n_ctx",
        "n_gpu_layers",
        "temperature",
        "top_k",
        "top_p",
        "seed",
        "max_tokens",
        "hardware",
        "operating_system"
      ],
      "properties": {
        "engine": {"type": ["string", "null"]},
        "engine_version": {"type": ["string", "null"]},
        "engine_revision": {"type": ["string", "null"]},
        "chat_template": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "source", "artifact", "applied"],
          "properties": {
            "mode": {"type": ["string", "null"]},
            "source": {"type": ["string", "null"]},
            "artifact": {"$ref": "#/$defs/artifact"},
            "applied": {"type": ["boolean", "null"]}
          }
        },
        "n_ctx": {"type": ["integer", "null"], "minimum": 1},
        "n_gpu_layers": {"type": ["integer", "null"], "minimum": -1},
        "temperature": {"type": ["number", "null"], "minimum": 0},
        "top_k": {"type": ["integer", "null"], "minimum": 0},
        "top_p": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "seed": {"type": ["integer", "null"], "minimum": 0},
        "max_tokens": {"type": ["integer", "null"], "minimum": 1},
        "hardware": {"type": ["string", "null"]},
        "operating_system": {"type": ["string", "null"]}
      }
    },
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "artifact",
        "development_population",
        "reference_outcomes_inspected_during_selection",
        "frozen_before_final_evaluation",
        "stopping_rule",
        "selection_history_artifact"
      ],
      "properties": {
        "id": {"type": ["string", "null"]},
        "artifact": {"$ref": "#/$defs/artifact"},
        "development_population": {"type": ["string", "null"]},
        "reference_outcomes_inspected_during_selection": {"type": ["boolean", "null"]},
        "frozen_before_final_evaluation": {"type": ["boolean", "null"]},
        "stopping_rule": {"type": ["string", "null"]},
        "selection_history_artifact": {"$ref": "#/$defs/artifact"}
      }
    },
    "grammar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "artifact", "purpose"],
      "properties": {
        "mode": {"enum": ["gbnf", "json_schema", "none", null]},
        "artifact": {"$ref": "#/$defs/artifact"},
        "purpose": {"type": ["string", "null"]}
      }
    },
    "key_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "report_key_column",
        "report_key_namespace",
        "report_key_normalization",
        "patient_key_column",
        "patient_key_namespace",
        "patient_key_semantics_confirmed"
      ],
      "properties": {
        "report_key_column": {"type": ["string", "null"]},
        "report_key_namespace": {"type": ["string", "null"]},
        "report_key_normalization": {"enum": ["exact_string", null]},
        "patient_key_column": {"type": ["string", "null"]},
        "patient_key_namespace": {"type": ["string", "null"]},
        "patient_key_semantics_confirmed": {"type": ["boolean", "null"]}
      }
    },
    "cohorts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/cohort"}
    },
    "privacy_boundary": {"type": ["string", "null"]}
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": ["string", "null"]},
        "sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-fA-F]{64}$"
        }
      }
    },
    "tabular_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact", "table"],
      "properties": {
        "artifact": {"$ref": "#/$defs/artifact"},
        "table": {"type": "string", "minLength": 1}
      }
    },
    "provenance_node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "node_type",
        "status",
        "repository_id",
        "revision",
        "artifact",
        "parents",
        "distribution_status"
      ],
      "properties": {
        "node_id": {"type": ["string", "null"]},
        "node_type": {
          "enum": [
            "upstream_weights_quantization",
            "producing_configuration",
            "inherited_evaluation_framework",
            "integration",
            "integrated_configuration",
            "run",
            "result",
            null
          ]
        },
        "status": {
          "enum": [
            "external_pending_intake",
            "external_receipted",
            "validated_pending_author_admission",
            "author_group_admitted",
            "integrated",
            "source_of_record",
            null
          ]
        },
        "repository_id": {"type": ["string", "null"]},
        "revision": {
          "type": ["string", "null"],
          "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64}|sha256:[0-9a-fA-F]{64})$"
        },
        "artifact": {"$ref": "#/$defs/artifact"},
        "parents": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "distribution_status": {
          "enum": [
            "receipt_only",
            "source_config_publishable",
            "outputs_governed",
            "weights_not_redistributed",
            null
          ]
        }
      }
    },
    "role_assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assertion_id",
        "node_id",
        "role",
        "party",
        "status",
        "scope",
        "revision",
        "evidence_artifact"
      ],
      "properties": {
        "assertion_id": {"type": ["string", "null"]},
        "node_id": {"type": ["string", "null"]},
        "role": {
          "enum": [
            "originator",
            "contributor",
            "custodian",
            "maintainer",
            "received_from",
            "scientific_governance",
            null
          ]
        },
        "party": {"type": ["string", "null"]},
        "status": {"enum": ["confirmed", "pending", "unconfirmed", null]},
        "scope": {"type": ["string", "null"]},
        "revision": {
          "type": ["string", "null"],
          "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64}|sha256:[0-9a-fA-F]{64})$"
        },
        "evidence_artifact": {"$ref": "#/$defs/artifact"}
      }
    },
    "cohort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cohort_id", "role", "manifest", "population", "predictions"],
      "properties": {
        "cohort_id": {"type": ["string", "null"]},
        "role": {"enum": ["development", "evaluation", "descriptive_unlabeled", null]},
        "manifest": {"$ref": "#/$defs/tabular_artifact"},
        "population": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_records",
            "candidate_records",
            "included_records",
            "excluded_records_by_reason",
            "reference_complete_records",
            "prediction_expected_records"
          ],
          "properties": {
            "source_records": {"type": ["integer", "null"], "minimum": 0},
            "candidate_records": {"type": ["integer", "null"], "minimum": 0},
            "included_records": {"type": ["integer", "null"], "minimum": 0},
            "excluded_records_by_reason": {
              "type": "object",
              "additionalProperties": {"type": "integer", "minimum": 0}
            },
            "reference_complete_records": {"type": ["integer", "null"], "minimum": 0},
            "prediction_expected_records": {"type": ["integer", "null"], "minimum": 0}
          }
        },
        "predictions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "surface",
            "report_key_column",
            "label_columns",
            "invalid_records",
            "unfinished_records"
          ],
          "properties": {
            "surface": {"$ref": "#/$defs/tabular_artifact"},
            "report_key_column": {"type": ["string", "null"]},
            "label_columns": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "Focal Epi",
                "Gen Epi",
                "Focal Non-epi",
                "Gen Non-epi",
                "Abnormality"
              ],
              "properties": {
                "Focal Epi": {"type": ["string", "null"]},
                "Gen Epi": {"type": ["string", "null"]},
                "Focal Non-epi": {"type": ["string", "null"]},
                "Gen Non-epi": {"type": ["string", "null"]},
                "Abnormality": {"type": ["string", "null"]}
              }
            },
            "invalid_records": {"type": ["integer", "null"], "minimum": 0},
            "unfinished_records": {"type": ["integer", "null"], "minimum": 0}
          }
        }
      }
    }
  }
}
