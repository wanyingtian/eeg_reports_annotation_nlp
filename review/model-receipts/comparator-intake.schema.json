{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/eeg-review/comparator-intake.schema.json",
  "title": "JBHI comparator producing-bundle intake",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "evidence_layer",
    "model_identity",
    "runtime",
    "prompt",
    "grammar",
    "key_contract",
    "cohorts",
    "privacy_boundary"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "status": {
      "enum": ["template_unreceipted", "draft", "frozen", "source_of_record", null]
    },
    "evidence_layer": {
      "enum": [
        "submitted_mistral",
        "reproduced_mistral",
        "post_submission_medgemma",
        null
      ]
    },
    "model_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "upstream_repo_id",
        "upstream_revision",
        "artifact",
        "size_bytes",
        "quantization",
        "license"
      ],
      "properties": {
        "upstream_repo_id": {"type": ["string", "null"]},
        "upstream_revision": {"type": ["string", "null"]},
        "artifact": {"$ref": "#/$defs/artifact"},
        "size_bytes": {"type": ["integer", "null"], "minimum": 0},
        "quantization": {"type": ["string", "null"]},
        "license": {"type": ["string", "null"]}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine",
        "engine_version",
        "engine_revision",
        "chat_template",
        "n_ctx",
        "n_gpu_layers",
        "temperature",
        "top_k",
        "top_p",
        "seed",
        "max_tokens",
        "hardware",
        "operating_system"
      ],
      "properties": {
        "engine": {"type": ["string", "null"]},
        "engine_version": {"type": ["string", "null"]},
        "engine_revision": {"type": ["string", "null"]},
        "chat_template": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "source", "artifact", "applied"],
          "properties": {
            "mode": {"type": ["string", "null"]},
            "source": {"type": ["string", "null"]},
            "artifact": {"$ref": "#/$defs/artifact"},
            "applied": {"type": ["boolean", "null"]}
          }
        },
        "n_ctx": {"type": ["integer", "null"], "minimum": 1},
        "n_gpu_layers": {"type": ["integer", "null"], "minimum": -1},
        "temperature": {"type": ["number", "null"], "minimum": 0},
        "top_k": {"type": ["integer", "null"], "minimum": 0},
        "top_p": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "seed": {"type": ["integer", "null"], "minimum": 0},
        "max_tokens": {"type": ["integer", "null"], "minimum": 1},
        "hardware": {"type": ["string", "null"]},
        "operating_system": {"type": ["string", "null"]}
      }
    },
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "artifact",
        "development_population",
        "reference_outcomes_inspected_during_selection",
        "frozen_before_final_evaluation",
        "stopping_rule",
        "selection_history_artifact"
      ],
      "properties": {
        "id": {"type": ["string", "null"]},
        "artifact": {"$ref": "#/$defs/artifact"},
        "development_population": {"type": ["string", "null"]},
        "reference_outcomes_inspected_during_selection": {"type": ["boolean", "null"]},
        "frozen_before_final_evaluation": {"type": ["boolean", "null"]},
        "stopping_rule": {"type": ["string", "null"]},
        "selection_history_artifact": {"$ref": "#/$defs/artifact"}
      }
    },
    "grammar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "artifact", "purpose"],
      "properties": {
        "mode": {"enum": ["gbnf", "json_schema", "none", null]},
        "artifact": {"$ref": "#/$defs/artifact"},
        "purpose": {"type": ["string", "null"]}
      }
    },
    "key_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "report_key_column",
        "report_key_namespace",
        "report_key_normalization",
        "patient_key_column",
        "patient_key_namespace",
        "patient_key_semantics_confirmed"
      ],
      "properties": {
        "report_key_column": {"type": ["string", "null"]},
        "report_key_namespace": {"type": ["string", "null"]},
        "report_key_normalization": {"enum": ["exact_string", null]},
        "patient_key_column": {"type": ["string", "null"]},
        "patient_key_namespace": {"type": ["string", "null"]},
        "patient_key_semantics_confirmed": {"type": ["boolean", "null"]}
      }
    },
    "cohorts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/cohort"}
    },
    "privacy_boundary": {"type": ["string", "null"]}
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": ["string", "null"]},
        "sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-fA-F]{64}$"
        }
      }
    },
    "tabular_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact", "table"],
      "properties": {
        "artifact": {"$ref": "#/$defs/artifact"},
        "table": {"type": "string", "minLength": 1}
      }
    },
    "cohort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cohort_id", "role", "manifest", "population", "predictions"],
      "properties": {
        "cohort_id": {"type": ["string", "null"]},
        "role": {"enum": ["development", "evaluation", "descriptive_unlabeled", null]},
        "manifest": {"$ref": "#/$defs/tabular_artifact"},
        "population": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_records",
            "candidate_records",
            "included_records",
            "excluded_records_by_reason",
            "reference_complete_records",
            "prediction_expected_records"
          ],
          "properties": {
            "source_records": {"type": ["integer", "null"], "minimum": 0},
            "candidate_records": {"type": ["integer", "null"], "minimum": 0},
            "included_records": {"type": ["integer", "null"], "minimum": 0},
            "excluded_records_by_reason": {
              "type": "object",
              "additionalProperties": {"type": "integer", "minimum": 0}
            },
            "reference_complete_records": {"type": ["integer", "null"], "minimum": 0},
            "prediction_expected_records": {"type": ["integer", "null"], "minimum": 0}
          }
        },
        "predictions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "surface",
            "report_key_column",
            "label_columns",
            "invalid_records",
            "unfinished_records"
          ],
          "properties": {
            "surface": {"$ref": "#/$defs/tabular_artifact"},
            "report_key_column": {"type": ["string", "null"]},
            "label_columns": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "Focal Epi",
                "Gen Epi",
                "Focal Non-epi",
                "Gen Non-epi",
                "Abnormality"
              ],
              "properties": {
                "Focal Epi": {"type": ["string", "null"]},
                "Gen Epi": {"type": ["string", "null"]},
                "Focal Non-epi": {"type": ["string", "null"]},
                "Gen Non-epi": {"type": ["string", "null"]},
                "Abnormality": {"type": ["string", "null"]}
              }
            },
            "invalid_records": {"type": ["integer", "null"], "minimum": 0},
            "unfinished_records": {"type": ["integer", "null"], "minimum": 0}
          }
        }
      }
    }
  }
}
